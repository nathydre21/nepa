# NEPA frontend environment (Vite).
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time — so these must be set when the frontend image is built (see the
# VITE_API_URL build arg in frontend/Dockerfile), not at container runtime.

# Base URL the SPA calls for the REST API.
# In the containerised stack the frontend nginx proxies /api → backend, so a
# same-origin relative path is the default. For a split deploy (CDN + separate
# API host) set the absolute URL, e.g. https://api.nepa.example.com/api
VITE_API_URL=/api

# Stellar network the UI targets. testnet for staging, mainnet ("public") for
# production. Kept alongside the backend's STELLAR_NETWORK so both tiers agree.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
