# ─────────────────────────────────────────────────────────────────────────────
# NEPA — STAGING environment (Stellar testnet)
#
# Copy to the repo root as `.env` on the staging host, then fill in secrets:
#     cp deploy/.env.staging.example .env
# docker-compose.prod.yml reads this file for both ${VAR} interpolation and the
# backend container's runtime environment. NEVER commit the filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Release / images ────────────────────────────────────────────────────────
# Tag deployed by the CD pipeline (git short-SHA or release tag). deploy/deploy.sh
# overrides this per run; the value here is only the compose default.
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/nathydre21/nepa-backend
FRONTEND_IMAGE=ghcr.io/nathydre21/nepa-frontend
FRONTEND_PORT=8080

# ── Database (primary) ──────────────────────────────────────────────────────
POSTGRES_USER=nepa
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
POSTGRES_DB=nepa
# Derived by compose from the POSTGRES_* values above; override only for an
# external/managed database.
DATABASE_URL=postgresql://nepa:CHANGE_ME_staging_db_password@postgres:5432/nepa?schema=public

# ── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Stellar (testnet) ───────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Only needed if this environment deploys the contract; leave blank otherwise.
STELLAR_SECRET_KEY=

# ── Frontend build arg (baked at image build time) ──────────────────────────
VITE_API_URL=/api

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_staging_jwt_secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Observability / notifications ───────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
# Generic alert sink; deploy/notify.sh posts deployment status here.
WEBHOOK_ALERT_URL=
