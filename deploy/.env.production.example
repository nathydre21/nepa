# ─────────────────────────────────────────────────────────────────────────────
# NEPA — PRODUCTION environment (Stellar mainnet / "public")
#
# Copy to the repo root as `.env` on the production host, then fill in secrets:
#     cp deploy/.env.production.example .env
# docker-compose.prod.yml reads this file for both ${VAR} interpolation and the
# backend container's runtime environment. NEVER commit the filled-in .env;
# store the real secrets in the CD "production" environment / a secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# ── Release / images ────────────────────────────────────────────────────────
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/nathydre21/nepa-backend
FRONTEND_IMAGE=ghcr.io/nathydre21/nepa-frontend
FRONTEND_PORT=8080

# ── Database (primary) ──────────────────────────────────────────────────────
POSTGRES_USER=nepa
POSTGRES_PASSWORD=CHANGE_ME_production_db_password
POSTGRES_DB=nepa
DATABASE_URL=postgresql://nepa:CHANGE_ME_production_db_password@postgres:5432/nepa?schema=public

# ── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Stellar (mainnet) ───────────────────────────────────────────────────────
STELLAR_NETWORK=mainnet
STELLAR_HORIZON_URL=https://horizon.stellar.org
# Deployer secret for the mainnet contract; inject from the secrets manager —
# do not store the real value in a file on disk.
STELLAR_SECRET_KEY=

# ── Frontend build arg (baked at image build time) ──────────────────────────
VITE_API_URL=/api

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_production_jwt_secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Observability / notifications ───────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
WEBHOOK_ALERT_URL=
